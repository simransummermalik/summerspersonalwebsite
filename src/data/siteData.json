    {
      "id": "research",
      "label": "Research",
      "content": {
        "kicker": "",
        "heading": "Research",
        "text": "Spatial computing, quantum machine learning, and cancer genomics."
      },
      "detail": {
        "actionLabel": "Enter research stars",
        "kicker": "Research Constellation",
        "heading": "Choose a signal.",
        "intro": "Each star opens one research thread so the section feels like exploring a constellation instead of reading a resume panel.",
        "quantumGalaxy": {
          "title": "Quantum work",
          "nodes": [
            {
              "id": "qml-research",
              "label": "QML Research",
              "text": "Hybrid quantum-classical experiments",
              "position": [-1.9, 0.72, 0.18],
              "detail": {
                "heading": "QML Research",
                "body": "Hybrid quantum-classical experiments studying where quantum feature spaces change model behavior, how variational circuits drift across retraining, and how QCNNs compare against small classical CNN baselines.",
                "items": ["Identity drift across retraining", "Quantum CNN vs classical CNN baselines", "Parameterized quantum circuits", "Noise-aware simulation labs"],
                "highlights": [
                  "Presented quantum machine learning work at the CRA Computing Research Association conference in New Orleans on 4/24/2026.",
                  "Focused on honest comparisons between classical and quantum-enhanced architectures, including prediction drift, representation drift, and parameter drift."
                ],
                "conference": {
                  "heading": "CRA UR2PhD Workshop + Research Showcase",
                  "body": "I attended the Computing Research Association's UR2PhD Undergraduate Mentoring Workshop and Research Showcase, a nationally competitive research-focused event for undergraduate students interested in PhD pathways in computing. I was selected as one of about 100 students from across the country, presented my quantum machine learning research, and connected with undergraduate researchers, PhD students, faculty, and mentors in New Orleans.",
                  "images": ["conferenceImage1", "conferenceImage2", "conferenceImage3"],
                  "imageAlt": "Summer at the CRA UR2PhD Undergraduate Mentoring Workshop and Research Showcase",
                  "links": [
                    {
                      "label": "Research poster",
                      "assetKey": "researchPosterPdf"
                    },
                    {
                      "label": "LinkedIn post",
                      "url": "https://www.linkedin.com/feed/update/urn:li:activity:7455061669082378241/"
                    }
                  ]
                },
                "artifactsHeading": "Colab notebooks",
                "artifacts": [
                  {
                    "title": "Identity Drift in Hybrid Quantum-Classical Models",
                    "label": "Open notebook",
                    "assetKey": "identityDriftNotebook",
                    "description": "A research notebook testing whether hybrid QML models preserve behavior over time, measuring prediction drift, representation drift, and parameter drift across seeds, retraining, noise, and perturbation."
                  },
                  {
                    "title": "Quantum Convolutional Neural Network",
                    "label": "Open notebook",
                    "assetKey": "quantumCnnNotebook",
                    "description": "A QCNN experiment for small 4x4 Fashion-MNIST images, comparing a PennyLane + PyTorch quantum-classical model against a tiny classical CNN baseline."
                  }
                ]
              }
            },
            {
              "id": "qml-torch",
              "label": "qml-torch",
              "text": "PyTorch + PennyLane + Qiskit toolkit",
              "position": [1.45, 0.36, -0.48],
              "detail": {
                "heading": "QML Torch",
                "body": "A next-generation framework that bridges quantum computation with deep learning, designed as a hardware-agnostic research environment for reproducible QML experiments.",
                "items": ["PyTorch pipelines", "PennyLane layers", "Qiskit backends"]
              }
            },
            {
              "id": "division-teaching",
              "label": "Division + Teaching",
              "text": "Student research group and quantum ML lessons",
              "position": [-0.35, -1.05, 0.36],
              "zoom": "deep",
              "detail": {
                "heading": "Division + Teaching Group",
                "overview": "I lead Charlotte AI Research's Quantum Machine Learning division, building QML Torch while designing labs, curriculum, and experiments around variational circuits, quantum kernels, feature maps, decoherence, gradient flow, expressivity, and optimization stability.",
                "body": "A research cockpit for the division: lessons, experiments, and poster artifacts orbit this star.",
                "note": "These are only a few. I will add notebooks and meeting notes later.",
                "meta": "Total entries: 4 - Last updated 10/20/2025",
                "notebooks": [
                  {
                    "label": "BB84",
                    "title": "Quantum Key Distribution - BB84 Protocol Experiment",
                    "date": "10/20/2025",
                    "description": "Experimental implementation of the BB84 quantum key distribution protocol using Qiskit, exploring quantum randomness, measurement disturbance, and eavesdrop detection."
                  },
                  {
                    "label": "QAOA",
                    "title": "Quantum Optimization - UNC Charlotte Traveling Salesman (QAOA)",
                    "date": "10/20/2025",
                    "description": "Hands-on experiment demonstrating QAOA using UNC Charlotte buildings to solve the Traveling Salesman Problem both classically and quantumly."
                  },
                  {
                    "label": "XOR",
                    "title": "Quantum XOR - Visualizing Entanglement and Nonlinearity",
                    "date": "9/30/2025",
                    "description": "Conceptual quantum reimagining of XOR, built to show how quantum logic and interference patterns could replicate nonlinearity in ML decision spaces."
                  },
                  {
                    "label": "Layer",
                    "title": "QML Torch: Conceptual Quantum Layer Experiment",
                    "date": "9/24/2025",
                    "description": "Initial QML Torch lab exploring how quantum superposition and entanglement can conceptually extend classical nonlinear modeling."
                  }
                ],
                "poster": {
                  "heading": "CAIR Research Poster",
